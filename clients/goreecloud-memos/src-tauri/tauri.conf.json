{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoreeCloud Memos",
  "version": "0.1.0",
  "identifier": "com.goreecloud.memos",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Private quick-note capture for GoreeCloud",
    "longDescription": "First-party Linux and Android client for the privacy-first, self-hosted GoreeCloud Memos service.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
