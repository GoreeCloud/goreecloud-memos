# Copy the exact immutable tag-and-digest reference from the successful tagged
# GoreeCloud Container workflow before production deployment.
GOREECLOUD_MEMOS_IMAGE=ghcr.io/goreecloud/memos:goreecloud-vX.Y.Z@sha256:REPLACE_WITH_VALIDATED_DIGEST

# These are target paths for a GoreeCloud Memos deployment. Do not move or delete
# historical Notes-branded data until backup, restore, cutover, and rollback are validated.
GOREECLOUD_MEMOS_DATA_PATH=/srv/docker/appdata/memos
GOREECLOUD_MEMOS_CONFIG_PATH=/srv/docker/secrets/memos
GOREECLOUD_PROXY_NETWORK=proxy
GOREECLOUD_MEMOS_TZ=America/Chicago
